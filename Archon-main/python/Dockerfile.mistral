# Use a Python base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install build tools needed to compile llama.cpp
RUN apt-get update && apt-get install -y build-essential cmake curl

# Install llama-cpp-python with OpenAI-compatible server dependencies
# This will compile llama.cpp from source, creating the shared library.
RUN pip install "llama-cpp-python[server]"

# Expose the port the server will run on
EXPOSE 8080

# The command to run the server will be provided by docker-compose
